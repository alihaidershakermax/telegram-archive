# Existing bot settings
BOT_TOKEN=
OWNER_ID=
ARCHIVE_CHANNEL_ID=
MONGO_URI=
DB_NAME=telegram_archive_db
BROADCAST_DELAY=0.05
CACHE_TTL_SECONDS=60
WELCOME_PHOTO=
BROADCAST_CHANNEL_ID=
PORT=8000

# Bot API authentication. Generate a long random value.
API_KEY=
API_RATE_LIMIT=60

# OpenAI-compatible AI Gateway. The base URL must expose /chat/completions.
# Examples: https://api.openai.com/v1 or an internal compatible provider.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-5-mini
AI_REQUEST_TIMEOUT_SECONDS=45

# Bot Factory. Use a 32-byte base64 or 64-character hex key; never commit the real value.
FACTORY_ENCRYPTION_KEY=
FACTORY_MAX_BOTS_PER_OWNER=5
FACTORY_WORKERS=8
FACTORY_DEFAULT_MAX_USERS=10000
FACTORY_DEFAULT_MAX_FILES=10000
FACTORY_DEFAULT_MAX_STORAGE_BYTES=5368709120
FACTORY_DEFAULT_MAX_REQUESTS_PER_MINUTE=120

# Durable Storage Gateway queue
STORAGE_QUEUE_POLL_SECONDS=5
STORAGE_MAX_ATTEMPTS=5
STORAGE_RETRY_BASE_SECONDS=5
STORAGE_QUEUE_BATCH_SIZE=10

# Parent bot database auto-expansion controller
DB_AUTO_EXPANSION=true
DB_EXPANSION_POLL_SECONDS=60
DB_EXPANSION_BATCH_SIZE=500
DB_EXPANSION_MAX_DOCS=100000
DB_EXPANSION_MAX_BYTES=10737418240
DB_EXPANSION_LOCK_SECONDS=300
DB_EXPANSION_COOLDOWN_SECONDS=300
