    classDef risk fill:#fee2e2,stroke:#dc2626,color:#7f1d1d

    class U,A,C,TG,LLM external
    class PRIMARY,UPD,ROUTER,H,AUTHZ,HTTP,APIAUTH,APIV1,APIV2,FACTORYH,MANAGER,VALIDATE,CIPHER,WORKERS,POLICY,HEALTH,ARCH,ADM,AIH app
    class AS,ADS,AIGW,BUNDLE,ZIP,METRICS service
    class DB,REG,IDX,TGA data
    class TMP risk
